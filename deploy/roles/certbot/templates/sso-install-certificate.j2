#!/bin/sh
# certbot runs this after it gets or renews the certificate in $RENEWED_LINEAGE, which only root can read.
set -eu
install -D -o root -g sso -m 0640 "$RENEWED_LINEAGE/fullchain.pem" {{ sso_tls_dir }}/fullchain.pem
install -D -o root -g sso -m 0640 "$RENEWED_LINEAGE/privkey.pem" {{ sso_tls_dir }}/privkey.pem
systemctl restart sso
