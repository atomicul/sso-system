[Unit]
Description=SSO
Wants=network-online.target
After=network-online.target mssql-server.service

[Service]
Type=exec
User=sso
Group=sso
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory={{ sso_install_dir }}/current
ExecStart={{ dotnet_root }}/dotnet {{ sso_install_dir }}/current/Sso.Server.dll
EnvironmentFile={{ sso_config_dir }}/database.env
EnvironmentFile={{ sso_config_dir }}/certificate.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ROOT={{ dotnet_root }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
